  "scripts": {
    "dev": "NODE_ENV=development tsx server/index.ts",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist && node scripts/build-vercel-api-bundle.mjs",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "test": "vitest run",
    "test:database": "ALLOW_DATABASE_TEST_WRITES=true vitest run server/tests/quotes.test.ts",
    "cutover:preflight": "node scripts/cutover-preflight.mjs",
    "env:check": "node scripts/validate-env.mjs",
    "smoke:lead-intake": "node scripts/smoke-lead-intake.mjs",
    "smoke:email": "tsx scripts/smoke-email.ts",
    "vercel:bundle-function": "node scripts/bundle-vercel-function.mjs",
    "vercel:build-output": "npm run build && npm run vercel:bundle-function",
    "deploy:prod": "node scripts/deploy-production.mjs",
    "deploy:prod:verify": "node scripts/verify-production-deploy.mjs",
    "deploy:prod:logs": "npx vercel@latest logs rainmaker.edgpatioshade.com --scope edgpatioshade --since 30m --status-code 500 --no-follow --expand",
    "storage:inventory": "node scripts/storage-inventory.mjs",
    "assets:audit": "node scripts/audit-attached-assets.mjs",
    "secrets:audit": "node scripts/audit-secrets.mjs",
    "storage:migrate-to-blob": "node scripts/migrate-quote-images-to-blob.mjs",
    "storage:migrate-brand-assets-to-blob": "node scripts/migrate-brand-assets-to-blob.mjs",
    "db:ensure-lead-fields": "node scripts/ensure-lead-fields.mjs",
    "db:ensure-lead-attachments": "node scripts/ensure-lead-attachments.mjs",
    "db:audit:schema": "node scripts/audit-database-schema.mjs",
    "db:push": "drizzle-kit push"
  },
