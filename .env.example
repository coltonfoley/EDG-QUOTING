# Copy this file to .env.local for local development.
# Never commit real secret values.

DATABASE_URL=
SESSION_SECRET=

APP_BASE_URL=http://localhost:5000
PORT=5000
HOST=0.0.0.0
ADDITIONAL_ALLOWED_ORIGINS=

# Google Workspace is the only human sign-in method.
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
GOOGLE_AUTH_ALLOWED_DOMAIN=edgpatioshade.com
GOOGLE_AUTH_AUTO_CREATE_USERS=false
GOOGLE_AUTH_ADMIN_EMAILS=

# Vercel Blob is the production storage provider.
OBJECT_STORAGE_PROVIDER=vercel-blob
BLOB_READ_WRITE_TOKEN=

# Customer emails send through the real EDG Google Workspace mailbox.
EMAIL_PROVIDER=google-workspace-gmail
GOOGLE_WORKSPACE_EMAIL_FROM=sales@edgpatioshade.com
GOOGLE_WORKSPACE_EMAIL_FROM_NAME=EDG Patio & Shade
GOOGLE_WORKSPACE_EMAIL_REPLY_TO=sales@edgpatioshade.com
# Preferred: use the EDG Google Workspace service account with Gmail send delegation.
GOOGLE_SERVICE_ACCOUNT_KEY=
# Fallback: use a sales@ OAuth refresh token if service-account mail is unavailable.
GOOGLE_WORKSPACE_CLIENT_ID=
GOOGLE_WORKSPACE_CLIENT_SECRET=
GOOGLE_WORKSPACE_REFRESH_TOKEN=
EMAIL_SMOKE_TO=

RAINMAKER_API_KEY=
VITE_GOOGLE_PLACES_API_KEY=
OPENAI_API_KEY=
GOOGLE_SERVICE_ACCOUNT_KEY=

# Manual Rainmaker -> Ops handoff. Keep this explicit; do not auto-import on
# closed-won until the operating rules are approved.
OPERATIONS_BASE_URL=
OPERATIONS_IMPORT_URL=
OPERATIONS_IMPORT_TOKEN=
OPERATIONS_IMPORT_TIMEOUT_MS=15000
